# LSX-VE logs live on their own 250 MiB partition (/var/log/lsxve): rotate by size so the
# partition never fills up. logrotate.timer runs hourly on LSX-VE (90-lsxve.conf drop-in).
# Per file at most: the live log (10 MiB + one hour of growth) and 6 compressed generations.
/var/log/lsxve/*.log {
    size 10M
    rotate 6
    compress
    missingok
    notifempty
    create 0640 root lsxve
    sharedscripts
    postrotate
        /usr/bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}
