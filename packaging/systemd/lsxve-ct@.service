[Unit]
Description=LSX-VE LXC container %i
Documentation=man:lxc-start(1)
After=network-online.target virtnetworkd.service lxcfs.service
Wants=lxcfs.service
# started and stopped by lsxve-agent (systemctl start lsxve-ct@NAME); the
# LXC path comes from /etc/lxc/lxc.conf

[Service]
Type=simple
# warnings and errors of lxc-start go to the LSX-VE log partition (shown when a start fails)
ExecStart=/usr/bin/lxc-start -F -n %i --logpriority=WARN --logfile=/var/log/lsxve/lxc-%i.log
# "-": when the container shut itself down, lxc-stop reports "not running"; that is not a failure
ExecStop=-/usr/bin/lxc-stop -n %i -t 90
TimeoutStopSec=120
KillMode=mixed
Delegate=yes
# an exit after lxc-stop -k or a container crash is reported, not retried
Restart=no
